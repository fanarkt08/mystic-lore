classDiagram
  direction LR
  note "Elixir n’a pas de classes : ce diagramme représente les structures (schémas Ecto) et les modules (fonctions)."
  namespace Schémas_Ecto {
    class CheckoutSession["MlBilling.CheckoutSession"] {
      <<schema checkout_sessions>>
      +id : binary_id «PK»
      +user_id : Ecto.UUID
      +plan : string
      +status : string = "open"
      +provider : string
      +provider_session_id : string
      +expires_at : utc_datetime
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class CreditAccount["MlBilling.CreditAccount"] {
      <<schema credit_accounts>>
      +user_id : binary_id «PK»
      +period : string
      +plan : string
      +allocation : integer = 0
      +balance : integer = 0
      +reserved : integer = 0
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class CreditEntry["MlBilling.CreditEntry"] {
      <<schema credit_entries>>
      +id : binary_id «PK»
      +seq : integer
      +user_id : Ecto.UUID
      +kind : string
      +amount : integer
      +delta : integer
      +balance_after : integer
      +ref : string
      +reason : string
      +period : string
      +inserted_at : utc_datetime_usec
    }
    class Invoice["MlBilling.Invoice"] {
      <<schema invoices>>
      +id : binary_id «PK»
      +user_id : Ecto.UUID
      +provider : string
      +provider_invoice_id : string
      +provider_subscription_id : string
      +amount_cents : integer
      +currency : string
      +status : string
      +period_start : utc_datetime
      +period_end : utc_datetime
      +hosted_url : string
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Subscription["MlBilling.Subscription"] {
      <<schema subscriptions>>
      +id : binary_id «PK»
      +user_id : Ecto.UUID
      +plan : string = "free"
      +status : string = "none"
      +provider : string
      +provider_customer_id : string
      +provider_subscription_id : string
      +current_period_start : utc_datetime
      +current_period_end : utc_datetime
      +cancel_at_period_end : boolean = false
      +past_due_since : utc_datetime
      +last_event_at : utc_datetime
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class WebhookEvent["MlBilling.WebhookEvent"] {
      <<schema webhook_events>>
      +id : binary_id «PK»
      +provider : string
      +provider_event_id : string
      +type : string
      +event_created_at : utc_datetime
      +user_id : Ecto.UUID
      +status : string
      +error : string
      +payload : map
      +inserted_at : utc_datetime
    }
  }
  namespace Modules_de_contexte {
    class MlBilling["MlBilling"] {
      <<module>>
      +entitlements(user_id, now)
      +create_checkout(user_id, params)
      +simulate_payment(user_id, id, params)
      +cancel(user_id)
      +resume(user_id)
      +broadcast(sub)
    }
    class Webhooks["MlBilling.Webhooks"] {
      <<module>>
      +handle(provider, raw_body, signature_header)
    }
    class Credits["MlBilling.Credits"] {
      <<module>>
      +reserve(user_id, amount, ref, reason, now)
      +consume(user_id, ref, now)
      +release(user_id, ref, now)
      +adjust(user_id, amount, ref, audit, now)
      +sync_plan(user_id, now)
      +overview(user_id, page, now)
    }
    class Signature["MlBilling.Signature"] {
      <<module>>
      +header(payload, secret, timestamp)
      +verify(payload, header, secret, now)
    }
    class Notices["MlBilling.Notices"] {
      <<module>>
      +transition!(old, new)
    }
    class PeriodEndWorker["MlBilling.PeriodEndWorker"] {
      <<Oban.Worker file default>>
      +perform(job)
    }
  }
  MlBilling ..> Subscription
  MlBilling ..> CheckoutSession
  MlBilling ..> Invoice
  Webhooks ..> WebhookEvent
  Webhooks ..> Subscription
  Webhooks ..> Invoice
  Webhooks ..> CheckoutSession
  Credits ..> CreditAccount
  Credits ..> CreditEntry
  PeriodEndWorker ..> Subscription
