classDiagram
  direction LR
  note "Elixir n’a pas de classes : ce diagramme représente les structures (schémas Ecto) et les modules (fonctions)."
  namespace Schémas_Ecto {
    class EmailLog["MlNotifications.EmailLog"] {
      <<schema email_log>>
      +id : id «PK»
      +user_id : binary_id
      +dedupe_key : string
      +category : string
      +kind : string
      +inserted_at : utc_datetime_usec
      +sent_at : utc_datetime_usec
    }
    class Setting["MlNotifications.Setting"] {
      <<schema notification_settings>>
      +user_id : binary_id «PK»
      +channels : map = %｛｝
      +quiet_enabled : boolean = false
      +quiet_start : time = ~T[22:00:00]
      +quiet_end : time = ~T[07:00:00]
      +time_zone : string
      +inserted_at : utc_datetime_usec
      +updated_at : utc_datetime_usec
    }
    class Notification["MlNotifications.Notification"] {
      <<schema notifications>>
      +id : binary_id «PK»
      +user_id : binary_id
      +category : string
      +kind : string
      +actor_id : binary_id
      +subject_type : string
      +subject_id : string
      +params : map = %｛｝
      +dedupe_key : string
      +count : integer = 1
      +read_at : utc_datetime_usec
      +last_event_at : utc_datetime_usec
      +inserted_at : utc_datetime_usec
      +updated_at : utc_datetime_usec
    }
    class PendingEmail["MlNotifications.PendingEmail"] {
      <<schema pending_emails>>
      +id : binary_id «PK»
      +user_id : binary_id
      +notification_id : binary_id
      +category : string
      +kind : string
      +actor_id : binary_id
      +params : map = %｛｝
      +dedupe_key : string
      +mandatory : boolean = false
      +inserted_at : utc_datetime_usec
    }
  }
  namespace Modules_de_contexte {
    class Inbox["MlNotifications.Inbox"] {
      <<module>>
      +create(caller, attrs, now)
      +list(user_id, params)
      +unread_count(user_id)
      +read(user_id, id, now)
      +read_all(user_id, now)
      +read_by_key(caller, attrs, now)
      +clear_between(attrs)
      +purge(now)
    }
    class Preferences["MlNotifications.Preferences"] {
      <<module>>
      +get(user_id)
      +enabled?(s, category, channel, kind)
      +update(user_id, attrs, now)
    }
    class Emails["MlNotifications.Emails"] {
      <<module>>
      +plan(input, setting, notification, now)
      +limited?(user_id, key, now)
      +request(user_id, body)
    }
    class QuietHours["MlNotifications.QuietHours"] {
      <<module>>
      +active?(s, now)
      +ends_at(s, now)
    }
    class Catalog["MlNotifications.Catalog"] {
      <<module>>
      +validate(svc, attrs)
      +mandatory?(kind)
    }
    class EmailWorker["MlNotifications.EmailWorker"] {
      <<Oban.Worker file email>>
      +perform(job)
    }
    class DigestWorker["MlNotifications.DigestWorker"] {
      <<Oban.Worker file email>>
      +perform(job)
    }
  }
  Inbox ..> Notification
  Inbox ..> PendingEmail
  Preferences ..> Setting
  Emails ..> EmailLog
  Emails ..> PendingEmail
