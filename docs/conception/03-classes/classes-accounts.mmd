      +lifted_by : Ecto.UUID
      +lift_reason : string
      +user_id : binary_id «FK»
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Session["MlAccounts.Session"] {
      <<schema sessions>>
      +id : binary_id «PK»
      +token_hash : binary «redact»
      +last_used_at : utc_datetime
      +user_agent : string
      +ip : string
      +user_id : binary_id «FK»
      +inserted_at : utc_datetime
    }
    class SupportReply["MlAccounts.SupportReply"] {
      <<schema support_replies>>
      +id : binary_id «PK»
      +author_id : Ecto.UUID
      +body : string
      +email_status : string
      +request_id : binary_id «FK»
      +inserted_at : utc_datetime
    }
    class SupportRequest["MlAccounts.SupportRequest"] {
      <<schema support_requests>>
      +id : binary_id «PK»
      +reference : string
      +user_id : Ecto.UUID
      +email : string
      +topic : string
      +message : string
      +locale : string = "en"
      +status : string = "open"
      +internal_note : string
      +answered_at : utc_datetime
      +closed_at : utc_datetime
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Throttle["MlAccounts.Throttle"] {
      <<schema throttle_events>>
      +id : id «PK»
      +key : string
      +inserted_at : utc_datetime
      +reserve(key, limit, minutes)
      +reserve(schema, field, key, limit, minutes)
      +clear(key)
    }
    class UserToken["MlAccounts.UserToken"] {
      <<schema user_tokens>>
      +id : binary_id «PK»
      +context : string
      +token_hash : binary «redact»
      +sent_to : string
      +user_id : binary_id «FK»
      +inserted_at : utc_datetime
    }
    class User["MlAccounts.User"] {
      <<schema users>>
      +id : binary_id «PK»
      +email : string
      +username : string
      +display_name : string
      +bio : string
      +password : string «virtual» «redact»
      +hashed_password : string «redact»
      +role : string = "user"
      +confirmed_at : utc_datetime
      +totp_secret : binary «redact»
      +totp_pending_secret : binary «redact»
      +totp_last_step : integer
      +totp_enabled_at : utc_datetime
      +deletion_scheduled_at : utc_datetime
      +deleted_at : utc_datetime
      +restricted_until : utc_datetime
      +pronouns : string
      +interests : array~string~ = []
      +cover : string
      +profile_visibility : string = "members"
      +avatar_crest : string
      +avatar_image : string
      +onboarding_status : string = "pending"
      +onboarding_at : utc_datetime
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
      +preferences : Preferences «embeds»
    }
  }
  namespace Modules_de_contexte {
    class MlAccounts["MlAccounts"] {
      <<module>>
      +register(attrs)
      +confirm(token)
      +login(email, password, client)
      +complete_two_factor_login(challenge, code, client)
      +get_session_user(token)
      +change_password(user, attrs, keep_token)
      +request_password_reset(email)
      +reset_password(token, attrs)
      +update_profile(user, attrs)
      +update_preferences(user, attrs)
    }
    class TwoFactor["MlAccounts.TwoFactor"] {
      <<module>>
      +setup(user, password)
      +enable(user, code, now)
      +disable(user, password, code)
      +verify(user, code, now)
      +regenerate_recovery_codes(user, password)
    }
    class Privacy["MlAccounts.Privacy"] {
      <<module>>
      +request_export(user, password)
      +build_export(export_id, last_attempt?)
      +schedule_deletion(user, params)
      +cancel_deletion(user)
      +execute_deletion(user_id)
    }
    class Sanctions["MlAccounts.Sanctions"] {
      <<module>>
      +issue(staff, target_id, params)
      +lift(staff, sanction_id, params)
      +appeal(member, sanction_id, params)
      +decide(staff, appeal_id, params)
    }
    class Support["MlAccounts.Support"] {
      <<module>>
      +create(requester, params)
      +reply(staff, id, params)
      +update(staff, id, params)
      +delete(admin, id)
      +purge(now)
    }
    class Audit["MlAccounts.Audit"] {
      <<module>>
      +record!(actor_id, action, target_type, target_id, reason, metadata)
      +create(service, attrs)
      +list(params)
      +export(admin, params)
    }
    class Incidents["MlAccounts.Incidents"] {
      <<module>>
      +open(staff, params)
      +add_update(staff, id, params)
      +list(params)
    }
  }
