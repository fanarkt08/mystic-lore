classDiagram
  direction LR
  note "Elixir n’a pas de classes : ce diagramme représente les structures (schémas Ecto) et les modules (fonctions)."
  namespace Schémas_Ecto {
    class Preferences["MlAccounts.Preferences"] {
      <<embedded_schema>>
      +language : string = "auto"
      +time_zone : string = "auto"
      +theme : string = "system"
      +reduce_motion : boolean = false
      +high_contrast : boolean = false
      +text_size : integer = 100
      +underline_links : boolean = false
      +captions : boolean = true
      +daily_xp_goal : integer = 20
    }
    class AuditEntry["MlAccounts.AuditEntry"] {
      <<schema audit_entries>>
      +id : id «PK»
      +service : string
      +actor_id : Ecto.UUID
      +action : string
      +target_type : string
      +target_id : string
      +reason : string
      +metadata : map = %｛｝
      +inserted_at : utc_datetime_usec
    }
    class ConfirmationToken["MlAccounts.ConfirmationToken"] {
      <<schema confirmation_tokens>>
      +id : binary_id «PK»
      +token_hash : binary «redact»
      +user_id : binary_id «FK»
      +inserted_at : utc_datetime
    }
    class DataExport["MlAccounts.DataExport"] {
      <<schema data_exports>>
      +id : binary_id «PK»
      +status : string = "pending"
      +data : map «redact»
      +failed_services : array~string~ = []
      +completed_at : utc_datetime
      +expires_at : utc_datetime
      +user_id : binary_id «FK»
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class DeletionStep["MlAccounts.DeletionStep"] {
      <<schema deletion_steps>>
      +user_id : binary_id «PK» «FK»
      +service : string «PK»
      +inserted_at : utc_datetime
    }
    class IncidentUpdate["MlAccounts.IncidentUpdate"] {
      <<schema incident_updates>>
      +id : binary_id «PK»
      +author_id : Ecto.UUID
      +body : string
      +status : string
      +severity : string
      +incident_id : binary_id «FK»
      +inserted_at : utc_datetime
    }
    class Incident["MlAccounts.Incident"] {
      <<schema incidents>>
      +id : binary_id «PK»
      +title : string
      +severity : string
      +status : string = "open"
      +summary : string
      +created_by : Ecto.UUID
      +resolved_by : Ecto.UUID
      +resolved_at : utc_datetime
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class LoginChallenge["MlAccounts.LoginChallenge"] {
      <<schema login_challenges>>
      +id : binary_id «PK»
      +token_hash : binary «redact»
      +attempts : integer = 0
      +user_id : binary_id «FK»
      +inserted_at : utc_datetime
    }
    class LoginFailure["MlAccounts.LoginFailure"] {
      <<schema login_failures>>
      +id : id «PK»
      +email : string
      +inserted_at : utc_datetime
    }
    class RecoveryCode["MlAccounts.RecoveryCode"] {
      <<schema recovery_codes>>
      +id : binary_id «PK»
      +code_hash : binary «redact»
      +user_id : binary_id «FK»
      +inserted_at : utc_datetime
    }
    class SanctionAppeal["MlAccounts.SanctionAppeal"] {
      <<schema sanction_appeals>>
      +id : binary_id «PK»
      +body : string
      +status : string = "open"
      +decided_by : Ecto.UUID
      +decision_reason : string
      +decided_at : utc_datetime
      +sanction_id : binary_id «FK»
      +user_id : binary_id «FK»
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Sanction["MlAccounts.Sanction"] {
      <<schema sanctions>>
      +id : binary_id «PK»
      +kind : string
