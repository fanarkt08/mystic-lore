classDiagram
  direction LR
  note "Elixir n’a pas de classes : ce diagramme représente les structures (schémas Ecto) et les modules (fonctions)."
  namespace Schémas_Ecto {
    class Lobby["MlMultiplayer.Lobby"] {
      <<schema lobbies>>
      +id : binary_id «PK»
      +host_id : binary_id
      +title : string
      +visibility : string = "open"
      +requires_approval : boolean = false
      +max_players : integer = 4
      +starts_at : utc_datetime_usec
      +status : string = "waiting"
      +current_match_id : binary_id
      +inserted_at : utc_datetime_usec
      +updated_at : utc_datetime_usec
    }
    class Invite["MlMultiplayer.Invite"] {
      <<schema lobby_invites>>
      +id : binary_id «PK»
      +lobby_id : binary_id
      +inviter_id : binary_id
      +invitee_id : binary_id
      +status : string = "pending"
      +inserted_at : utc_datetime_usec
      +updated_at : utc_datetime_usec
    }
    class Link["MlMultiplayer.Link"] {
      <<schema lobby_links>>
      +id : binary_id «PK»
      +lobby_id : binary_id
      +created_by : binary_id
      +token_hash : binary «redact»
      +expires_at : utc_datetime_usec
      +max_uses : integer
      +uses : integer = 0
      +revoked_at : utc_datetime_usec
      +inserted_at : utc_datetime_usec
    }
    class Member["MlMultiplayer.Member"] {
      <<schema lobby_members>>
      +lobby_id : binary_id «PK»
      +user_id : binary_id «PK»
      +status : string
      +ready : boolean = false
      +connection : string = "online"
      +last_seen_at : utc_datetime_usec
      +joined_at : utc_datetime_usec
      +inserted_at : utc_datetime_usec
      +updated_at : utc_datetime_usec
    }
    class Message["MlMultiplayer.Message"] {
      <<schema lobby_messages>>
      +id : binary_id «PK»
      +lobby_id : binary_id
      +user_id : binary_id
      +body : string
      +inserted_at : utc_datetime_usec
    }
    class MatchEvent["MlMultiplayer.MatchEvent"] {
      <<schema match_events>>
      +match_id : binary_id «PK»
      +seq : integer «PK»
      +type : string
      +user_id : binary_id
      +payload : map = %｛｝
      +inserted_at : utc_datetime_usec
    }
    class Reward["MlMultiplayer.Reward"] {
      <<schema match_rewards>>
      +id : binary_id «PK»
      +match_id : binary_id
      +user_id : binary_id
      +amount : integer
      +status : string = "pending"
      +attempts : integer = 0
      +next_attempt_at : utc_datetime_usec
      +last_error : string
      +awarded_at : utc_datetime_usec
      +inserted_at : utc_datetime_usec
      +updated_at : utc_datetime_usec
    }
    class Match["MlMultiplayer.Match"] {
      <<schema matches>>
      +id : binary_id «PK»
      +lobby_id : binary_id
      +status : string = "active"
      +last_seq : integer = 0
      +finished_at : utc_datetime_usec
      +inserted_at : utc_datetime_usec
      +updated_at : utc_datetime_usec
    }
  }
  namespace Modules_de_contexte {
    class Lobbies["MlMultiplayer.Lobbies"] {
      <<module>>
      +create(user_id, attrs)
      +join(user_id, lobby_id)
      +approve(host_id, lobby_id, user_id)
      +set_ready(user_id, lobby_id, ready)
      +start(host_id, lobby_id, now)
      +attempt(user_id, lobby_id, sequence)
      +leave(user_id, lobby_id)
      +kick(host_id, lobby_id, user_id)
    }
    class Invitations["MlMultiplayer.Invitations"] {
      <<module>>
      +invite(host_id, lobby_id, invitee_id)
      +accept(user_id, invite_id)
      +decline(user_id, invite_id)
      +create_link(host_id, lobby_id, attrs, now)
      +join_link(user_id, token, now)
    }
    class Matches["MlMultiplayer.Matches"] {
      <<module>>
      +create!(lobby, players, seed)
      +replay(match_id)
      +commit(match_id, expected_seq, events, state)
    }
    class MatchServer["MlMultiplayer.MatchServer"] {
      <<module GenServer>>
      +propose(match_id, user_id, sequence)
      +set_absent(match_id, user_id, absent?)
      +abort(match_id, reason)
    }
    class RuneRelay["MlMultiplayer.RuneRelay"] {
      <<module>>
      +start_event(seed, players)
      +init(map)
      +decide(state, user_id, intent)
      +score(secret, seq)
    }
    class Chat["MlMultiplayer.Chat"] {
      <<module>>
      +list(user_id, lobby_id, before)
      +post(user_id, lobby_id, attrs, now)
    }
    class Rewards["MlMultiplayer.Rewards"] {
      <<module>>
      +finalize(match_id, now)
      +deliver_due(now)
    }
    class Presence["MlMultiplayer.Presence"] {
      <<module>>
      +heartbeat(user_id, lobby_id, now)
      +sweep(now)
    }
  }
