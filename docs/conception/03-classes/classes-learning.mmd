classDiagram
  direction LR
  note "Elixir n’a pas de classes : ce diagramme représente les structures (schémas Ecto) et les modules (fonctions)."
  namespace Schémas_Ecto {
    class Catalog_Adventure["MlLearning.Catalog.Adventure"] {
      <<schema adventures>>
      +id : binary_id «PK»
      +slug : string
      +title : string
      +summary : string
      +description : string = ""
      +category : string
      +difficulty : string
      +premium : boolean = false
      +duration_minutes : integer
      +cover : string
      +objectives : array~string~ = []
      +prerequisites : array~string~ = []
      +source : string
      +external_id : binary_id
      +imported_version : integer
      +author_id : binary_id
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Gamification_Badge["MlLearning.Gamification.Badge"] {
      <<schema badges>>
      +id : binary_id «PK»
      +slug : string
      +name : string
      +description : string
      +icon : string
      +rarity : string
      +criterion : string
      +param : string
      +target : integer
      +position : integer
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Catalog_Chapter["MlLearning.Catalog.Chapter"] {
      <<schema chapters>>
      +id : binary_id «PK»
      +position : integer
      +title : string
      +adventure_id : binary_id «FK»
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Progress_Enrollment["MlLearning.Progress.Enrollment"] {
      <<schema enrollments>>
      +id : binary_id «PK»
      +user_id : binary_id
      +completed_at : utc_datetime
      +adventure_id : binary_id «FK»
      +last_lesson_id : binary_id «FK»
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Offline_Action["MlLearning.Offline.Action"] {
      <<schema idempotent_actions>>
      +id : binary_id «PK»
      +user_id : binary_id
      +key : binary_id
      +action : string
      +request_hash : string
      +response : map = %｛｝
      +lesson_id : binary_id «FK»
      +inserted_at : utc_datetime
    }
    class Progress_LessonProgress["MlLearning.Progress.LessonProgress"] {
      <<schema lesson_progress>>
      +id : binary_id «PK»
      +user_id : binary_id
      +status : string = "in_progress"
      +attempts : integer = 0
      +notes : string
      +draft : string
      +notes_saved_at : utc_datetime
      +completed_at : utc_datetime
      +lesson_id : binary_id «FK»
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Catalog_Lesson["MlLearning.Catalog.Lesson"] {
      <<schema lessons>>
      +id : binary_id «PK»
      +position : integer
      +title : string
      +kind : string
      +body : string = ""
      +content : map = %｛｝
      +solution : map = %｛｝ «redact»
      +xp_reward : integer
      +revision : integer = 1
      +revised_at : utc_datetime
      +chapter_id : binary_id «FK»
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Gamification_Quest["MlLearning.Gamification.Quest"] {
      <<schema quests>>
      +id : binary_id «PK»
      +slug : string
      +title : string
      +description : string
      +kind : string
      +target : integer
      +xp_reward : integer
      +position : integer
      +inserted_at : utc_datetime
      +updated_at : utc_datetime
    }
    class Gamification_UserBadge["MlLearning.Gamification.UserBadge"] {
      <<schema user_badges>>
      +id : binary_id «PK»
      +user_id : binary_id
      +earned_at : utc_datetime
      +equipped : boolean = false
      +position : integer
      +badge_id : binary_id «FK»
    }
    class Progress_XpEvent["MlLearning.Progress.XpEvent"] {
      <<schema xp_events>>
      +id : binary_id «PK»
      +user_id : binary_id
      +ref_key : string
      +amount : integer
      +inserted_at : utc_datetime
    }
  }
  namespace Modules_de_contexte {
    class Catalog["MlLearning.Catalog"] {
      <<module>>
      +list_adventures(params)
      +fetch_adventure(slug)
      +fetch_lesson(id)
      +neighbours(lesson)
    }
    class Progress["MlLearning.Progress"] {
      <<module>>
      +enroll(user_id, adventure)
      +open(user_id, lesson)
      +submit(user_id, lesson, correct?)
      +complete(user_id, lesson)
      +award_xp(user_id, ref_key, amount)
      +dashboard(user_id, today)
    }
    class Grader["MlLearning.Grader"] {
      <<module>>
      +grade(lesson, answer, user_id)
    }
    class Gamification["MlLearning.Gamification"] {
      <<module>>
      +after_xp(user_id, today)
      +settle_quests(user_id, today)
      +profile(user_id)
    }
    class Gamification_Badges["MlLearning.Gamification.Badges"] {
      <<module>>
      +award(user_id, today)
      +achievements(user_id, today)
      +equip(user_id, badge_ids)
    }
    class Gamification_Quests["MlLearning.Gamification.Quests"] {
      <<module>>
      +settle(user_id, date)
    }
    class Offline["MlLearning.Offline"] {
      <<module>>
      +package(user_id, lesson, now)
      +submit(user_id, lesson, answer, replay)
      +complete(user_id, lesson, params, replay)
    }
    class Entitlements["MlLearning.Entitlements"] {
      <<module GenServer>>
      +check(map, user_id)
      +premium?(user_id)
      +fresh(user_id)
    }
    class Importer["MlLearning.Importer"] {
      <<module>>
      +import(params)
    }
  }
  Catalog_Adventure "1" -- "0..*" Catalog_Chapter : has_many chapters / belongs_to adventure
  Catalog_Adventure "1" -- "0..*" Progress_Enrollment : belongs_to adventure
  Catalog_Lesson "0..1" -- "0..*" Progress_Enrollment : belongs_to last_lesson
  Catalog_Lesson "1" -- "0..*" Offline_Action : belongs_to lesson
  Catalog_Lesson "1" -- "0..*" Progress_LessonProgress : belongs_to lesson
  Catalog_Chapter "1" -- "0..*" Catalog_Lesson : has_many lessons / belongs_to chapter
  Gamification_Badge "1" -- "0..*" Gamification_UserBadge : belongs_to badge
  Catalog ..> Catalog_Adventure
  Catalog ..> Catalog_Chapter
  Catalog ..> Catalog_Lesson
  Progress ..> Progress_Enrollment
  Progress ..> Progress_LessonProgress
  Progress ..> Progress_XpEvent
  Grader ..> Catalog_Lesson
  Gamification_Badges ..> Gamification_Badge
  Gamification_Badges ..> Gamification_UserBadge
  Gamification_Quests ..> Gamification_Quest
  Offline ..> Offline_Action
  Offline ..> Catalog_Lesson
  Importer ..> Catalog_Adventure
  Importer ..> Catalog_Chapter
  Importer ..> Catalog_Lesson
