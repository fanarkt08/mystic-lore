sequenceDiagram
  actor U as Membre
  participant N as Navigateur
  participant W as web (BFF :4000)
  box service accounts (:4001)
    participant A as accounts
    participant DB as ml_accounts (PostgreSQL)
  end

  rect rgb(250,250,250)
  Note over U,DB: Premier facteur : mot de passe
  U->>N: saisit e-mail et mot de passe
  N->>+W: 1 · POST /login (jeton CSRF)
  W->>W: 2 · RateLimit.check(:login) — 10 / min par IP en production
  W->>+A: 3 · POST /api/sessions {email, password} + x-client-ua, x-client-ip
  A->>DB: 4 · Throttle.reserve : verrou consultatif, purge, compte (≥ 5 en 15 min → 429), INSERT login_failures
  A->>DB: 5 · SELECT users — Bcrypt.verify_pass — si correct, DELETE login_failures
  A->>DB: 6 · 2FA active : INSERT login_challenges (SHA-256), aucune session créée
  A-->>-W: 7 · 200 {two_factor_required: true, challenge}
  W-->>-N: 302 /login/2fa — challenge gardé dans le cookie de session, jamais dans l’URL
  alt mot de passe faux ou e-mail inconnu
    A-->>W: 401 invalid_credentials
  else compte verrouillé (5 échecs / 15 min)
    A-->>W: 429 locked (même avec le bon mot de passe)
  else e-mail non confirmé / suppression échue
    A-->>W: 403 unconfirmed / 403 account_deleted
  end
  end

  rect rgb(250,250,250)
  Note over U,DB: Second facteur : code TOTP (application d’authentification)
  U->>N: saisit le code à 6 chiffres
  N->>+W: 8 · POST /login/2fa {code} — RateLimit.check(:two_factor)
  W->>+A: POST /api/sessions/2fa {challenge, code}
  A->>DB: 9 · UPDATE login_challenges SET attempts + 1 WHERE haché, < 5 essais, < 5 min RETURNING
  A->>DB: 10 · Throttle.reserve("totp:‹id›") — 5 codes faux / 15 min, tous challenges confondus
  A->>A: 11 · déchiffre le secret (AES-256-GCM) — NimbleTOTP sur le pas courant ±1
  A->>DB: 12 · UPDATE users SET totp_last_step (anti-rejeu : pas strictement plus récent)
  A->>DB: 13 · DELETE login_challenges (un challenge n’ouvre qu’une session)
  A->>DB: 14 · INSERT sessions (SHA-256 du jeton, appareil, IP anonymisée)
  A-->>-W: 201 {session_token, user}
  W->>W: 15 · Auth.log_in : session renouvelée (anti-fixation) — after_login_path
  W-->>-N: 302 /welcome (accueil « pending ») ou /dashboard ou la page demandée
  alt code faux, essais restants
    A-->>W: 401 {invalid_code, attempts_left}
  else challenge expiré, épuisé ou déjà utilisé
    A-->>W: 404 not_found → retour à /login
  else trop de codes faux
    A-->>W: 429 locked → retour à /login
  end
  end

  rect rgb(250,250,250)
  Note over U,DB: Chaque page connectée (LiveView)
  N->>+W: 16 · GET /dashboard — on_mount {MysticWeb.Auth, :require_user}
  W->>+A: 17 · GET /api/sessions/current (en-tête x-session-token)
  A->>DB: 18 · UPDATE sessions SET last_used_at WHERE haché ET utilisée depuis < 30 jours RETURNING
  A-->>-W: 200 {user}
  W-->>-N: page du membre (sinon 401 → /login?reason=expired)
  end
