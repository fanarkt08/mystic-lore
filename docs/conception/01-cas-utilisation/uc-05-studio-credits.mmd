%% @ref Image-VIP src/studio/lib/studio/ai.ex:498-506 | vip_required
usecase-beta
  direction LR
  actor Membre
  actor VIP(Membre VIP)
  actor Moderateur(Modérateur)
  actor IA(Fournisseur d’IA) <<système externe>>
  systemBoundary sys(MysticLore — studio)
    PROJ(Créer un projet d’aventure)
    REDIG(Rédiger modules et leçons)
    MEDIA(Téléverser images, vidéo et sous-titres)
    COLLAB(Inviter des collaborateurs)
    VERS(Enregistrer ou restaurer une version)
    GEN(Générer un plan, un brouillon ou un retour avec l’IA)
    RESA(Réserver puis régler les crédits IA)
    CTX(Partager le contexte du projet avec l’IA)
    IMG(Générer une image avec l’IA)
    APPL(Appliquer un résultat au projet)
    CONSENT(Donner ou retirer son consentement)
    CRED(Consulter ses crédits et l’historique)
    SOUM(Soumettre le projet à la relecture)
    CHECK(Passer les contrôles automatiques)
    RELIRE(Relire un projet soumis)
    PUBL(Publier l’aventure dans le catalogue)
  end
  Membre -- PROJ
  Membre -- REDIG
  Membre -- MEDIA
  Membre -- COLLAB
  Membre -- VERS
  Membre -- GEN
  Membre -- APPL
  Membre -- CONSENT
  Membre -- CRED
  Membre -- SOUM
  VIP -- IMG
  Moderateur -- RELIRE
  GEN ..>:include RESA
  CTX ..>:extend GEN
  IMG ..>:include RESA
  SOUM ..>:include CHECK
  PUBL ..>:extend RELIRE
  GEN -- IA
  note for CTX si le demandeur et le propriétaire ont consenti ; sinon le brief seul
  note for PUBL si le relecteur approuve ; import par learning
  note for COLLAB propriétaire ; éditeur ou lecteur
