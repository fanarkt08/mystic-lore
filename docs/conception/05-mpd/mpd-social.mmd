erDiagram
  direction LR
  attachments {
    uuid id PK
    uuid message_id FK, UK "NN · → messages.id CASCADE"
    uuid uploader_id "NN · ⇢ accounts.users"
    varchar(255) kind "NN"
    varchar(255) content_type "NN"
    integer byte_size "NN"
    integer width
    integer height
    varchar(255) filename
    text alt_text
    varchar(255) scan "NN"
    varchar(255) storage_key UK
    timestamp erased_at
    timestamp inserted_at "NN"
  }
  blocks {
    uuid blocker_id PK "⇢ accounts.users"
    uuid blocked_id PK "⇢ accounts.users"
    timestamp inserted_at "NN"
  }
  conversation_members {
    uuid conversation_id PK, FK "→ conversations.id CASCADE"
    uuid user_id PK "⇢ accounts.users"
    timestamp last_read_at
    timestamp joined_at "NN · déf. now()"
    timestamp muted_until
  }
  conversations {
    uuid id PK
    uuid user_low UK "UQ (user_low, user_high) · ⇢ accounts.users"
    uuid user_high UK "UQ (user_low, user_high) · ⇢ accounts.users"
    timestamp inserted_at "NN"
    varchar(255) kind "NN · déf. 'direct'"
    varchar(255) name
    uuid owner_id "⇢ accounts.users"
  }
  friendships {
    uuid id PK
    uuid requester_id "NN · UQ (LEAST(requester_id, addressee_id), GREATEST(requester_id, addressee_id)) · ⇢ accounts.users"
    uuid addressee_id "NN · UQ (LEAST(requester_id, addressee_id), GREATEST(requester_id, addressee_id)) · ⇢ accounts.users"
    varchar(255) status "NN · déf. 'pending'"
    timestamp inserted_at "NN"
    timestamp updated_at "NN"
  }
  messages {
    uuid id PK
    uuid conversation_id FK "NN · → conversations.id CASCADE"
    uuid sender_id "NN · ⇢ accounts.users"
    text body
    timestamp inserted_at "NN"
    timestamp removed_at
    uuid removed_by "⇢ accounts.users"
    varchar(255) kind "NN · déf. 'text'"
    jsonb system
  }
  reports {
    uuid id PK
    uuid reporter_id "NN · ⇢ accounts.users"
    varchar(255) target_type "NN"
    uuid target_id "NN · ⇢ accounts.users ou messages selon target_type"
    varchar(255) reason "NN"
    text details
    text message_body
    uuid message_sender_id "⇢ accounts.users"
    timestamp message_sent_at
    timestamp inserted_at "NN"
    varchar(255) status "NN · déf. 'open'"
    varchar(255) resolution
    text resolution_reason
    uuid resolved_by "⇢ accounts.users"
    timestamp resolved_at
    uuid sanction_id "⇢ accounts.sanctions"
    uuid message_attachment_id "⇢ attachments (l'instantané survit)"
  }
  settings {
    uuid user_id PK "⇢ accounts.users"
    boolean show_online "NN · déf. true"
    boolean read_receipts "NN · déf. true"
    varchar(255) friend_requests "NN · déf. 'everyone'"
    varchar(255) group_adds "NN · déf. 'friends'"
    varchar(255) lobby_invites "NN · déf. 'friends'"
    timestamp updated_at "NN"
  }
  messages ||..o| attachments : "message_id"
  conversations ||--o{ conversation_members : "conversation_id"
  conversations ||..o{ messages : "conversation_id"
