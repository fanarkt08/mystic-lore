%% @ref Web docker-compose.yml:83 | ports: ["4000:4000"]
%% @ref Seeds docker-compose.yml:21 | SEED_DEMO: ${SEED_DEMO:-true}
%% @ref Initdb src/docker-initdb.sql:1-8 | CREATE DATABASE ml_notifications;
%% @ref Dockerfile src/Dockerfile:3-4 | ARG ELIXIR_IMAGE=hexpm/elixir:1.20.5-erlang-29.1.2-debian-trixie-20261104-slim
