# Copiez en .env (jamais commité). Aucune valeur ci-dessous n'est un vrai secret.
# --- Base de données (défaut : utilisateur système, sans mot de passe, localhost)
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
# --- Secret interne entre services (obligatoire en prod, 64 caractères aléatoires au moins : mix phx.gen.secret)
INTERNAL_SECRET=
# --- Clé de chiffrement des secrets TOTP (2FA) d'accounts, ≥ 32 caractères (défaut : dérivée d'INTERNAL_SECRET)
TOTP_ENCRYPTION_KEY=
# --- URL publique de l'interface (liens d'e-mail, URLs de retour Stripe)
WEB_URL=http://localhost:4000
# --- Paiement : sans clés Stripe, mode simulé local en dev. Clés de test Stripe pour le vrai checkout :
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_VIP=
# BILLING_LOCAL_MODE=false   # désactive le paiement simulé
# --- Démo
SEED_DEMO_PASSWORD=mystic-demo-pass-1
# --- Studio IA : sans clé, fournisseur de démo local hors production ; en production sans clé, la génération est refusée.
# AI_PROVIDER=anthropic|demo     (défaut : anthropic si ANTHROPIC_API_KEY est défini, sinon demo)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-fable-5-2      (défaut), AI_EFFORT=high, AI_TIMEOUT_MS=60000
# --- Dossiers privés des fichiers téléversés, en chemin absolu (un chemin relatif est refusé au démarrage).
# Vides en dev, ils sont obligatoires en production, sur un volume persistant.
# Images et médias (vidéos, sous-titres) téléversés dans le studio
STUDIO_STORAGE_DIR=
# Avatars téléversés (accounts, sous-dossier avatars/ ; relayés par web sous /media/avatars/…)
ACCOUNTS_STORAGE_DIR=
# Pièces jointes des messages (social, sous-dossier attachments/ ; relayées par web sous /media/attachments/…,
# membres de la conversation seulement)
SOCIAL_STORAGE_DIR=
# --- Antivirus des pièces jointes (social) : démon clamd en TCP. Sans CLAMD_HOST, les fichiers sont acceptés
# comme « non analysés » ; configuré mais injoignable, le fichier est refusé.
# CLAMD_HOST=clamav   CLAMD_PORT=3310   CLAMD_TIMEOUT_MS=10000
CLAMD_HOST=
# --- Centre de notifications : délai (secondes) avant un e-mail facultatif, annulé si la notification est lue
# entre-temps (défaut 60 ; 10 en dev).
NOTIFICATIONS_EMAIL_DELAY_S=
# --- Délai avant suppression définitive d'un compte (jours, défaut 30 ; la suppression est annulable pendant ce délai)
ACCOUNT_DELETION_GRACE_DAYS=30
# --- Demandes du formulaire de contact : supprimées ce nombre de jours après leur clôture (défaut 180).
SUPPORT_RETENTION_DAYS=180
# --- Simulations (learning) : moteur natif Rust optionnel, repli Elixir aux résultats identiques
# SIM_ENGINE=auto|native|elixir   (défaut auto : natif s'il est construit par bin/setup)
# SIM_ENGINE_PATH=                (défaut src/learning/priv/native/ml_sim)
