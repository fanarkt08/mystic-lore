<!DOCTYPE html>
<html
  lang={Gettext.get_locale(MysticWeb.Gettext)}
  {assigns[:html_attrs] || MysticWeb.Preferences.html_attrs()}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="color-scheme"
      content={MysticWeb.Preferences.color_scheme(assigns[:theme] || "system")}
    />
    <meta name="theme-color" content="#090E20" />
    <%!-- application installable : manifeste et icônes générées par e2e/tools/make_icons.mjs --%>
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <link rel="apple-touch-icon" href={~p"/icons/icon-192.png"} />
    <.live_title default="MysticLore" suffix=" · MysticLore">{assigns[:page_title]}</.live_title>
    <%!-- polices auto-hébergées (assets/css/fonts.css) : rien n'est demandé à un tiers --%>
    <link
      rel="preload"
      href={~p"/fonts/inter-latin-400-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/cormorant-garamond-latin-600-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{gettext("Skip to content")}</a>
    {@inner_content}
  </body>
</html>
