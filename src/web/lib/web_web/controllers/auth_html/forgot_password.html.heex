<.auth_shell
  flash={@flash}
  eyebrow={gettext("Account recovery")}
  title={gettext("Forgot your password?")}
>
  <%= if @sent_to do %>
    <div id="reset-link-sent" class="space-y-4">
      <.notice kind="success" title={gettext("Check your email")}>
        {gettext(
          "If an account exists for %{email}, a link to choose a new password is on its way. It works once, within 1 hour.",
          email: @sent_to
        )}
      </.notice>
      <.notice :if={@dev_hints} id="dev-mailbox" kind="info" title={gettext("Development only")}>
        {gettext("E-mails are not really sent here: read them in the accounts dev mailbox.")}
        <:actions>
          <.button href={mailbox_url()} variant="secondary" target="_blank" rel="noopener">
            <.icon name="hero-envelope-open" /> {gettext("Open the dev mailbox")}
          </.button>
        </:actions>
      </.notice>
      <p class="text-sm text-muted">
        {gettext("No email after a few minutes? Check your spam folder or ask again.")}
      </p>
      <.button href={~p"/login"} variant="ghost">{gettext("Back to log in")}</.button>
    </div>
  <% else %>
    <p class="text-muted">
      {gettext(
        "Enter the email address of your account: we'll send you a link to choose a new one."
      )}
    </p>
    <.notice :if={@error} id="forgot-error" kind="danger" role="alert">{@error}</.notice>
    <.form for={@form} action={~p"/forgot-password"} id="forgot-form" class="space-y-4">
      <.input
        field={@form[:email]}
        type="email"
        label={gettext("Email")}
        autocomplete="email"
        required
      />
      <.button type="submit" class="w-full">{gettext("Send me a reset link")}</.button>
    </.form>
    <p class="text-sm text-muted">
      <.link href={~p"/login"} class="link">{gettext("Back to log in")}</.link>
    </p>
  <% end %>
</.auth_shell>
