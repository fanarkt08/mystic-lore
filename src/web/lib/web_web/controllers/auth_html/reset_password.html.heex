<.auth_shell
  flash={@flash}
  eyebrow={gettext("Account recovery")}
  title={gettext("Choose a new password")}
>
  <%= if @error == :invalid do %>
    <.access_state
      id="reset-invalid"
      icon="hero-link-slash"
      title={gettext("This link can't be used")}
    >
      {gettext(
        "The reset link is invalid, has expired (links last 1 hour) or has already been used."
      )}
      <:actions>
        <.button href={~p"/forgot-password"} variant="secondary">
          {gettext("Ask for a new link")}
        </.button>
        <.button href={~p"/login"} variant="ghost">{gettext("Back to log in")}</.button>
      </:actions>
    </.access_state>
  <% else %>
    <p class="text-muted">
      {gettext(
        "Saving it signs you out on every device. If two-factor authentication is on, it stays on."
      )}
    </p>
    <.notice :if={@error} id="reset-error" kind="warning" role="alert">{@error}</.notice>
    <.form for={@form} action={~p"/reset-password/#{@token}"} id="reset-form" class="space-y-4">
      <.input
        field={@form[:password]}
        type="password"
        label={gettext("New password")}
        hint={gettext("At least 12 characters.")}
        autocomplete="new-password"
        minlength="12"
        required
      />
      <.button type="submit" class="w-full">{gettext("Save my new password")}</.button>
    </.form>
  <% end %>
</.auth_shell>
